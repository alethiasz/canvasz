# Copie para .env se precisar ajustar algo.
# Porta publicada no host:
CANVASZ_PORT=8787
# Dono dos arquivos em ./data — use a saída de `id -u` e `id -g`:
PUID=1000
PGID=1000
# Tamanho máximo de cada arquivo enviado, em MB (0 = sem limite):
CANVASZ_MAX_UPLOAD_MB=500
# Backups mantidos pela rotação (0 = manter todos):
CANVASZ_BACKUP_KEEP=0
